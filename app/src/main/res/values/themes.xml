
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TEMA PRINCIPAL TV (Corregido para AppCompat) -->
    <style name="Theme.FullTV.tv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorPrimary">#282828</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- FALSE para evitar ver el fondo del TV -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- TEMA PARA TRANSICIONES (Corregido para AppCompat) -->
    <style name="Theme.SmoothTransition" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
<!-- TEMA DE ARRANQUE (Splash) - También debe ser sólido -->
<style name="Theme.App.Starting" parent="Theme.MaterialComponents.NoActionBar">
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowIsTranslucent">false</item>
    <item name="android:windowDisablePreview">false</item>
</style>

</resources>