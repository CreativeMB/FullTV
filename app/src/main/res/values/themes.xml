<resources xmlns:android="http://schemas.android.com/apk/res/android">


    <style name="Theme.FullTV.tv" parent="@style/Theme.Leanback" >

        <item name="android:colorPrimary">#282828</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>
    <style name="Theme.FullTV.main" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Atributos de tu tema -->
        <item name="colorPrimary">#282828</item>
        ...
    </style>

    <style name="Theme.App.Starting" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Fondo negro sólido para que coincida con tu layout -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <!-- Esto elimina animaciones de ventana que causan parpadeos al abrir -->
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Theme.SmoothTransition" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>