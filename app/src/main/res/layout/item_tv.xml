<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Imagen del Canal -->
        <ImageView
            android:id="@+id/imgMovie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="15dp"
            android:paddingBottom="35dp"
            android:scaleType="fitCenter"
            android:src="@drawable/pelifondo" />

        <!-- 1. La Cinta de Fondo (Le agregamos ID para referenciarla) -->
        <View
            android:id="@+id/viewCintaFondo"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/bg_bordes_difuminados"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 2. El Título centrado VERTICALMENTE en la Cinta -->
        <TextView
            android:id="@+id/txtMovieTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:gravity="center"
            android:text="Nombre del Canal"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        app:layout_constraintTop_toTopOf="@id/viewCintaFondo"
        app:layout_constraintBottom_toBottomOf="@id/viewCintaFondo"
        app:layout_constraintStart_toStartOf="@id/viewCintaFondo"
        app:layout_constraintEnd_toEndOf="@id/viewCintaFondo" />

        <!-- Badge TV (Izquierda) -->
        <TextView
            android:id="@+id/txtBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@color/fondo"
            android:paddingHorizontal="4dp"
            android:text="TV"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Badge LIVE (Derecha) -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/bg_status_red"
            android:paddingHorizontal="4dp"
            android:text="LIVE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Estrella de Favoritos -->
        <ImageView
            android:id="@+id/imgStar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="6dp"
            android:elevation="10dp"
            android:src="@android:drawable/btn_star_big_on"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/txtBadge"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFD700" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>