<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/headerContainer"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:padding="0dp"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <!-- Fila horizontal: imagen y texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Imagen del usuario -->
        <ImageView
            android:id="@+id/imagenuser"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icono"
            android:background="@drawable/icono"
            android:layout_marginEnd="12dp" />

        <!-- Info del usuario -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start"
            android:padding="0dp">

            <!-- Fecha y hora -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start">

                <TextView
                    android:id="@+id/textfecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textColor="@color/lb_tv_white"
                    android:textSize="25sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/textHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hora"
                    android:textColor="@color/lb_tv_white"
                    android:textSize="25sp"
                    android:layout_marginEnd="10dp" />
            </LinearLayout>

            <!-- Usuario y estado -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start">

                <TextView
                    android:id="@+id/textUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuario"
                    android:textColor="@color/lb_tv_white"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/useronline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON-0"
                    android:textColor="#00C505"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/useroff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF-0"
                    android:textColor="@color/rojo"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />
            </LinearLayout>

            <!-- Castv info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start">

                <TextView
                    android:id="@+id/textCastv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Películas y Castv"
                    android:textColor="@color/lb_tv_white"
                    android:textSize="25sp"
                    android:layout_marginEnd="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Texto de actualización tipo marquee -->
    <TextView
        android:id="@+id/txtActualizacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        android:text="Actualización"
        android:textColor="@color/rojo"
        android:textSize="16sp"
        android:visibility="visible"
        android:gravity="start"
        />
</LinearLayout>
