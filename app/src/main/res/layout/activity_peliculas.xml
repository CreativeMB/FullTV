<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- FONDO -->
    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:scaleType="centerCrop" />

    <!-- MENÚ PRINCIPAL (Izquierda/Centro) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menuPrincipal"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:nextFocusDown="@id/rvPeliculas"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layoutSaldo"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- CONTENEDOR DE SALDO PREMIUM (Esquina Superior Derecha) -->
    <LinearLayout
        android:id="@+id/layoutSaldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_saldo_premium"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSaldoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 CasTV: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </LinearLayout>

    <!-- GRID DE PELÍCULAS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPeliculas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:nextFocusLeft="@id/menuPrincipal"
        android:nextFocusRight="@id/menuPrincipal"
        android:nextFocusUp="@id/menuPrincipal"
        android:nextFocusDown="@id/rvPeliculas"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuPrincipal" />

</androidx.constraintlayout.widget.ConstraintLayout>