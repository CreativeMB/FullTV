<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:scaleType="centerCrop" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menuPrincipal"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:paddingHorizontal="20dp"
        android:descendantFocusability="afterDescendants"
        android:nextFocusDown="@id/rvBannerPromos"
        app:layout_constraintEnd_toStartOf="@+id/layoutSaldo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutSaldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_saldo_premium"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSaldoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 CasTV: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/layoutBannerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/menuPrincipal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- FONDO: Se mantienen igual -->
            <ImageView
                android:id="@+id/ivBannerBackdrop"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:contentDescription="Banner Backdrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_bordes_difuminados"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_degradado_netflix"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/cvBannerPoster"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- PÓSTER: CAMBIO -> Se elimina el anclaje superior y se fuerza al fondo con un margen -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvBannerPoster"
                android:layout_width="120dp"
                android:layout_height="170dp"
                android:layout_marginStart="10dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/ivBannerPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#333333" />
            </androidx.cardview.widget.CardView>

            <!-- INFO: CAMBIO -> Se elimina el anclaje superior. Ahora se ancla justo ENCIMA de las promos -->
            <LinearLayout
                android:id="@+id/layoutInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/rvBannerPromos"
                app:layout_constraintStart_toEndOf="@id/cvBannerPoster"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvBannerTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvBannerInfoAdicional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B0BEC5"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvBannerCalificacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFEB3B"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvBannerContador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#00E676"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBannerSinopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="15dp"
                    android:textColor="#E0E0E0"
                    android:textSize="18sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2" />

            </LinearLayout>

            <!-- PROMOS: CAMBIO -> Se ancla su parte inferior a la parte inferior del póster para que todo quede alineado abajo -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBannerPromos"
                android:layout_width="0dp"
                android:layout_height="15dp"
                android:layout_marginStart="16dp"
                android:orientation="horizontal"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/menuPrincipal"
                android:nextFocusDown="@id/rvPeliculas"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintBottom_toBottomOf="@id/cvBannerPoster"
                app:layout_constraintStart_toEndOf="@id/cvBannerPoster"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPeliculas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="25dp"
        android:paddingBottom="25dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/rvBannerPromos"
        app:layout_constraintTop_toBottomOf="@id/layoutBannerNetflix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>