<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- Brillo de fondo (Se mantiene perfectamente centrado detrás del logo) -->
    <View
        android:id="@+id/viewGlow"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:background="@drawable/splash_glow"
        app:layout_constraintTop_toTopOf="@id/imgLogoSplash"
        app:layout_constraintBottom_toBottomOf="@id/imgLogoSplash"
        app:layout_constraintStart_toStartOf="@id/imgLogoSplash"
        app:layout_constraintEnd_toEndOf="@id/imgLogoSplash" />

    <!-- 🟢 Logo (Inicia la cadena vertical empaquetada) -->
    <ImageView
        android:id="@+id/imgLogoSplash"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:src="@drawable/icono"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtBienvenido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Título (Siguiente en la cadena vertical) -->
    <TextView
        android:id="@+id/txtBienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:text="Nuevas historias"
        android:textColor="#C5A059"
        android:textStyle="bold"
        android:textSize="26sp"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:shadowColor="#000000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="10"
        app:layout_constraintTop_toBottomOf="@id/imgLogoSplash"
        app:layout_constraintBottom_toTopOf="@id/txtCargandoAnim"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Frases descriptivas (Siguiente en la cadena vertical) -->
    <TextView
        android:id="@+id/txtCargandoAnim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="Reuniendo al parche para una gran función"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:lineSpacingExtra="4dp"
        android:shadowColor="#C5A059"
        android:shadowRadius="12"
        app:layout_constraintTop_toBottomOf="@id/txtBienvenido"
        app:layout_constraintBottom_toTopOf="@id/progressBarSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de progreso horizontal (Siguiente en la cadena vertical) -->
    <ProgressBar
        android:id="@+id/progressBarSplash"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="250dp"
        android:layout_height="5dp"
        android:layout_marginTop="28dp"
        android:indeterminate="true"
        android:indeterminateTint="#C5A059"
        app:layout_constraintTop_toBottomOf="@id/txtCargandoAnim"
        app:layout_constraintBottom_toTopOf="@id/txtVersion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Versión (Finaliza la cadena vertical empaquetada) -->
    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="VERSIÓN 1.0.0"
        android:textColor="#C5A059"
        android:textStyle="bold"
        android:textSize="15sp"
        android:alpha="0.8"
        app:layout_constraintTop_toBottomOf="@id/progressBarSplash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>