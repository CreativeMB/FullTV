<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C">

    <!-- SCROLLVIEW: Permite deslizar si el contenido no cabe -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CONTENEDOR CENTRAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp"> <!-- Un poco de margen para que al hacer scroll no pegue a los bordes -->

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <!-- LOGO -->
                <ImageView
                    android:id="@+id/imgLogoSplash"
                    android:layout_width="160dp"
                    android:layout_height="200dp"
                    android:src="@drawable/icono"
                    android:scaleType="fitXY"
                    android:alpha="0" />

            </androidx.cardview.widget.CardView>


            <!-- VERSIÓN -->
            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:textColor="#F44336"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-light"
                android:alpha="0" />

            <!-- ESPACIO VISUAL -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- BARRA DE CARGA MODERNA -->
            <!-- Nota: cambié el ancho a 350dp para que sea un poco más adaptable a pantallas chicas sin romper el diseño -->
            <ProgressBar
                android:id="@+id/progressBarSplash"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="#E50914" />

            <!-- TÍTULO DE BIENVENIDA -->
            <TextView
                android:id="@+id/txtBienvenido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="BIENVENIDO"
                android:textColor="#FFC107"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <!-- FRASE MODERNA -->
            <TextView
                android:id="@+id/txtCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Organizando el contenido para\nuna experiencia inolvidable"
                android:textAlignment="center"
                android:textColor="#00BCD4"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>