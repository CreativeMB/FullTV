<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/transparent">


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_movies_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="invisible"
        android:overScrollMode="never"/>

    <!-- Contenedor inferior para imagen + controles -->
    <LinearLayout
        android:id="@+id/controles_reproductor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="bottom|center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">


        <!-- Imagen de la película más grande -->
        <ImageView
            android:id="@+id/imagenPelicula"
            android:layout_width="150dp"
            android:layout_height="230dp"
            android:scaleType="fitXY"
            android:src="@drawable/icono"
            android:contentDescription="Imagen de la película" />

        <!-- Controles del reproductor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/colorBarra"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Nombre de la película -->
            <TextView
                android:id="@+id/nombrePelicula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:layout_marginStart="15dp"
                android:focusableInTouchMode="true"
                android:gravity="start"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Nombre película"
                android:textColor="@color/exo_button_color"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- Barra de progreso -->
            <SeekBar
                android:id="@+id/progreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:background="@drawable/button_selector"
                android:max="100"
                android:progressTint="@color/colorSeekBar"
                android:thumbTint="@color/colorSeekBar1"
                android:layout_marginTop="5dp" />

            <!-- Controles inferiores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="15dp"
                android:gravity="center_vertical"
                android:paddingTop="5dp"
                android:weightSum="3">

                <!-- Tiempo reproducido -->
                <TextView
                    android:id="@+id/tiemporeproducido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:gravity="start"
                    android:layout_marginStart="5dp"
                    android:text="0:00"
                    android:textColor="@color/exo_button_color"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.8"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="5dp">



                    <ImageButton
                        android:id="@+id/render"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/button_selector"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_render"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:tint="@color/exo_button_color" />



                    <ImageButton
                        android:id="@+id/pedidos"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/button_selector"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pago"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:tint="@color/exo_button_color" />

                    <ImageButton
                        android:id="@+id/home"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/button_selector"
                        android:scaleType="fitCenter"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:src="@drawable/ic_cineflex"
                        app:tint="@color/exo_button_color" />
                    <ImageButton
                        android:id="@+id/play_pause"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/button_selector"
                        android:scaleType="fitCenter"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:src="@drawable/ic_play"
                        app:tint="@color/exo_button_color" />
                    <ImageButton
                        android:id="@+id/lista_pelis"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/button_selector"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pelis_menu"
                        app:tint="@color/exo_button_color"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                </LinearLayout>

                <!-- Tiempo total restante -->
                <TextView
                    android:id="@+id/tiempototal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="end"
                    android:layout_marginEnd="10dp"
                    android:text="-0:00"
                    android:textColor="@color/exo_button_color"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
