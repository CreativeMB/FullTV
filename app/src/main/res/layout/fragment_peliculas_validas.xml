<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔽 Primero el fondo para que quede atrás -->
    <ImageView
        android:id="@+id/backgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.6" />

    <!-- 🔼 Luego el Fragmento para que se dibuje encima del fondo -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/peliculasvalidas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Luego los textos y loading -->
    <TextView
        android:id="@+id/mensajeTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/redpersonalisado"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/redpersonalisado"
            style="?android:attr/progressBarStyleLarge"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cargando...\nActualizando biblioteca gratis"
            android:textColor="@color/redpersonalisado"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center" />
    </LinearLayout>
</FrameLayout>

