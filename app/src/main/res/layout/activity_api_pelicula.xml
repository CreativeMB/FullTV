<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <!-- Contenido principal dentro del ScrollView -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Fila principal: imagen + video + datos -->
            <LinearLayout
                android:id="@+id/topRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Fila principal: imagen + video + datos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Fila: imagen + datos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Poster -->
                        <ImageView
                            android:id="@+id/ivPoster"
                            android:layout_width="200dp"
                            android:layout_height="280dp"
                            android:scaleType="fitXY"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/icono" />

                        <!-- Contenedor de datos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Línea: Título + Calificación -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:id="@+id/tvTitulo"
                                    android:layout_width="0dp"
                                    android:layout_weight="2"
                                    android:layout_height="wrap_content"
                                    android:text="Título"
                                    android:textColor="@color/colorFocused"
                                    android:textStyle="bold"
                                    android:textSize="30sp" />

                                <TextView
                                    android:id="@+id/tvCalificacion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⭐ 8.5"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="40sp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginEnd="10dp"
                                    android:paddingStart="8dp" />
                            </LinearLayout>

                            <!-- Fecha de estreno -->
                            <TextView
                                android:id="@+id/tvFecha"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Estreno: 2024-07-19"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="20sp"
                                android:layout_marginBottom="4dp" />

                            <!-- Línea: Info adicional + Reproducir -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="4dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvInfoAdicional"
                                    android:layout_width="0dp"
                                    android:layout_weight="2"
                                    android:layout_height="wrap_content"
                                    android:textColor="@android:color/white"
                                    android:textSize="18sp"
                                    android:text="🎭 Géneros: Acción, Aventura\n⏱ 120 min"
                                    android:padding="2dp" />

                                <TextView
                                    android:id="@+id/tvReproducir"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="▶ Reproducir"
                                    android:textColor="@color/colorSeekBar"
                                    android:textSize="16sp"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:background="@drawable/focus_selector"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:clickable="true"
                                    android:layout_marginEnd="8dp"
                                    android:layout_marginStart="8dp" />
                            </LinearLayout>

                            <!-- Lista de actores -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerActores"
                                android:layout_width="match_parent"
                                android:layout_height="140dp"
                                android:orientation="horizontal"
                                android:padding="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 🔽 Sinopsis como última fila, ocupando todo el ancho -->
                    <TextView
                        android:id="@+id/tvSinopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sinopsis"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="18sp"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="6"
                        android:padding="8dp" />
                </LinearLayout>










            </LinearLayout>
    <!-- Contenedor del RecyclerView + capa de carga -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="16dp">

                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_movies_menu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:background="@android:color/transparent" />

                <!-- Capa de carga sobre el RecyclerView -->
                <FrameLayout
                    android:id="@+id/layoutCargando"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#00000000"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:paddingHorizontal="16dp">

                        <!-- Texto centrado en una sola línea -->
                        <TextView
                            android:id="@+id/loadingText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Cargando biblioteca de Pelis gratis..."
                            android:textColor="@color/redpersonalisado"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textAlignment="center" />

                        <!-- Barra de progreso horizontal ocupando todo el ancho -->
                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:progress="0"
                            android:max="100"
                            android:visibility="visible"
                            android:progressDrawable="@drawable/progress_bar_rojo" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>


        </LinearLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/backgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.1"
        android:visibility="visible" />

</FrameLayout>
