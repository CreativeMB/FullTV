<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@color/colorPrimary">

    <ImageView
        android:id="@+id/backgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:scaleType="centerCrop"
        android:visibility="visible" />


    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@android:color/transparent">



        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:background="@android:color/transparent"
            android:clipToPadding="false">

            <!-- Fila superior: imagen + datos -->
            <LinearLayout
                android:id="@+id/topRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivPoster"
                        android:layout_width="140dp"
                        android:layout_height="180dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/pelifondo" />

                </androidx.cardview.widget.CardView>

                <!-- Contenedor de datos -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Título y calificación -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="Título"
                            android:textColor="@color/colorFocused"
                            android:textSize="30sp"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <!-- Info adicional + Fecha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvInfoAdicional"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="🎭 Acción, Aventura ⏱ 120 min"
                            android:textColor="@android:color/white"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <!-- Fila de Actores y Fecha combinados -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Actores (80% del ancho) -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerActores"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="7"
                            android:orientation="horizontal"
                            android:clipToPadding="false"
                            android:clipChildren="false"
                            android:overScrollMode="never"
                            android:paddingEnd="8dp" />

                        <!-- Fecha (20% del ancho) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/focus_selector"
                            android:layout_marginEnd="10dp">
                            <TextView
                                android:id="@+id/tvCalificacion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:paddingStart="8dp"
                                android:text="⭐ 8.5"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="25sp" />

                            <TextView
                                android:id="@+id/tvFecha"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📅"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="25sp"
                                android:gravity="center" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Contenedor horizontal: Scroll de sinopsis + botón -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <!-- ScrollView con TextView de sinopsis -->
            <ScrollView
                android:id="@+id/scrollSinopsis"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:nestedScrollingEnabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:background="@drawable/button_selector">

                <TextView
                    android:id="@+id/tvSinopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:padding="4dp"
                    android:text="Sinopsis larga que puede ocupar varias líneas y hacer scroll dentro del área fija..."
                    android:textColor="@color/textColorPrimary"
                    android:textSize="18sp" />
            </ScrollView>

            <!-- Botón Reproducir -->
            <TextView
                android:id="@+id/tvReproducir"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="SIGUIENTE"
                android:textColor="@color/rojo"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cartelera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/peliscartelera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:descendantFocusability="afterDescendants"
                android:nextFocusLeft="@id/peliscartelera"
                android:nextFocusRight="@id/peliscartelera"
                 android:nextFocusUp="@id/tvReproducir"
                android:overScrollMode="never"
                android:padding="2dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:paddingHorizontal="10dp"/>


            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fondo decorativo -->
</FrameLayout>
