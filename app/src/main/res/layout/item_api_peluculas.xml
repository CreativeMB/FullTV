<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#1A1A1A">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/movie_image_small"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="fitXY"
                android:src="@drawable/pelifondo"
                android:contentDescription="Imagen de película" />

            <LinearLayout
                android:id="@+id/infoAreaSmall"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="vertical"
                android:gravity="top"
                android:paddingTop="2dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="#880E4F">

                <TextView
                    android:id="@+id/movie_title_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre Película"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:gravity="center_horizontal"
                    android:duplicateParentState="true" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtBadgeSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="#880E4F"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Alquilar 💳"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:elevation="8dp"
            android:translationZ="8dp"
            android:visibility="visible" />

    </FrameLayout>
</androidx.cardview.widget.CardView>