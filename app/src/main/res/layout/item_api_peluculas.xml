<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#1A1A1A">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/movie_image_small"
        android:layout_width="match_parent"
        android:layout_height="220dp"
    android:scaleType="fitXY"
    android:src="@drawable/pelifondo" />

    <TextView
        android:id="@+id/txtBadgeSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="#880E4F"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="ALQUILAR 💳"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />
</FrameLayout>

<LinearLayout
    android:id="@+id/infoAreaSmall"
    android:layout_width="match_parent"
    android:layout_height="35dp"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:background="#880E4F">

    <TextView
        android:id="@+id/movie_title_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre Película"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:gravity="center" />
</LinearLayout>
</LinearLayout>
    </androidx.cardview.widget.CardView>