<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:focusable="false"> <!-- El padre no debe tener foco -->

    <ImageView
        android:id="@+id/imgFondoTv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.2" />

    <TextView
        android:id="@+id/txtTituloTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="30dp"
        android:text="CANALES DE TELEVISIÓN"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginEnd="40dp"
        android:background="@color/fondoTexto"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="12dp"
        android:hint="Buscar canal..."
        android:paddingHorizontal="20dp"
        android:textColor="#ffffff"
        android:textColorHint="#aaaaaa"
        android:textSize="16sp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:focusable="true"
        android:nextFocusLeft="@id/searchEditText"
        android:nextFocusRight="@id/searchEditText"
        android:nextFocusUp="@id/searchEditText"
        android:nextFocusDown="@id/recyclerViewTV"
        app:layout_constraintBottom_toBottomOf="@id/txtTituloTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtTituloTv" />

    <!-- Contenedor del RecyclerView para atrapar el foco -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTV"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="30dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants"


    android:nextFocusUp="@id/searchEditText"
    android:nextFocusDown="@id/recyclerViewTV"
    android:nextFocusLeft="@id/recyclerViewTV"
    android:nextFocusRight="@id/recyclerViewTV"

    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/searchEditText" />

</androidx.constraintlayout.widget.ConstraintLayout>