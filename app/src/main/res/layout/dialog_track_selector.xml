<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:background="#D9121212"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Título Principal -->
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Audio y Subtítulos"
android:textColor="#C5A059"
android:textSize="16sp"
android:textStyle="bold"
android:layout_marginBottom="10dp"
android:gravity="center_horizontal" />

    <!-- Contenedor de Columnas -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="160dp"
android:orientation="horizontal"
android:baselineAligned="false">

<!-- Columna de Audio -->
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:layout_marginEnd="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IDIOMA DE AUDIO"
        android:textColor="#888888"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/contenedor_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>

<!-- Divisor Vertical Delgado -->
<View
    android:layout_width="1dp"
    android:layout_height="match_parent"
    android:background="#332E2E2E"
    android:layout_marginHorizontal="6dp"/>

<!-- Columna de Subtítulos -->
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:layout_marginStart="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SUBTÍTULOS"
        android:textColor="#888888"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/contenedor_subtitulos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
</LinearLayout>
    </LinearLayout>