<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.media3.ui.PlayerView
        android:id="@+id/reproductor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/negro"
        app:resize_mode="fill">
        <include layout="@layout/player_controles"/>
    </androidx.media3.ui.PlayerView>
    <!-- Contenedor premium de carga con indicador de búfer -->
    <LinearLayout
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- Anillo dorado animado -->
        <ProgressBar
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:indeterminate="true"
            android:indeterminateTint="@null"
            android:indeterminateDrawable="@drawable/loader_premium" />

        <!-- Título de la película -->
        <TextView
            android:id="@+id/loadingMovieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cargando película..."
            android:textColor="#C5A059"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <!-- TEXTO DINÁMICO DEL BÚFER (Reemplaza al texto fijo) -->
        <TextView
            android:id="@+id/loadingBufferText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Búfer: 0% (0 KB)"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:alpha="0.9" />
    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal|start"
        android:clipToPadding="false"
        android:background="#80000000"
        android:visibility="invisible"/>


</FrameLayout>