<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.media3.ui.PlayerView
        android:id="@+id/reproductor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/negro"
        app:resize_mode="fill">
        <include layout="@layout/player_controles"/>
    </androidx.media3.ui.PlayerView>

    <LinearLayout
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:indeterminate="true"
            android:indeterminateTint="@null"
            android:indeterminateDrawable="@drawable/loader_premium" />

        <TextView
            android:id="@+id/loadingMovieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cargando película..."
            android:textColor="#C5A059"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/loadingBufferText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Búfer: 0% (0 KB)"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:alpha="0.9" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTv"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingLeft="20dp"
        android:paddingEnd="20dp"
        android:paddingRight="20dp"
        android:nextFocusLeft="@id/recyclerViewTv"
        android:nextFocusRight="@id/recyclerViewTv"
        android:nextFocusDown="@id/recyclerViewTv"
        android:background="#80000000"
        android:visibility="invisible"/>

    <ImageView
        android:id="@+id/btnCerrarMenuTv"
        android:layout_width="45dp"
        android:layout_height="90dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="280dp"
        android:src="@drawable/pestana"
        android:scaleType="centerInside"
        android:focusable="false"
        android:clickable="true"
        android:contentDescription="Cerrar Menú"
        android:visibility="gone" />

</FrameLayout>