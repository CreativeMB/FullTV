<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color rojo para el estado En Vivo -->
    <solid android:color="#D32F2F" />

    <!-- Esquinas redondeadas (4dp para que sea sutil) -->
    <corners android:radius="4dp" />

    <!-- Opcional: Un pequeño borde oscuro para que resalte en imágenes claras -->
    <stroke
        android:width="1dp"
        android:color="#33000000" />
</shape>