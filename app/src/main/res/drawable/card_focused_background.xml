<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ESTADO CUANDO TIENE EL FOCO (Dorado Premium) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- Color de fondo sutil cuando está seleccionado (10% de blanco para dar brillo) -->
            <solid android:color="#A50277BD" />

            <!-- Borde Dorado Grueso: 3dp es ideal para que se vea bien en TV -->
            <stroke
                android:width="2dp"
                android:color="#C5A059" />

            <!-- Esquinas redondeadas suaves (Premium Look) -->
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- ESTADO NORMAL (Transparente) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>