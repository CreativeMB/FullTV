<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado: Cuando la vista tiene el foco -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC1D1D1D" /> <!-- Tu color de hover -->
        </shape>
    </item>

    <!-- Estado: Cuando la vista está presionada -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorFocused" /> <!-- Tu color de selección/presionado -->
        </shape>
    </item>

    <!-- Estado por defecto (sin foco, sin presionar) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorNotSelected" /> <!-- Tu color normal -->
        </shape>
    </item>

</selector>