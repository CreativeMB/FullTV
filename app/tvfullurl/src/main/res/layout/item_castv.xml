<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardElevation="6dp"
    app:cardCornerRadius="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:gravity="center_vertical">

        <!-- Contenedor de texto (70%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="7"
            android:paddingEnd="8dp">

            <!-- Nombre -->
            <TextView
                android:id="@+id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Nombre del usuario"
                android:layout_marginBottom="4dp" />

            <!-- Email -->
            <TextView
                android:id="@+id/userEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Email" />

            <!-- Castv + Fecha en misma fila -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <EditText
                    android:id="@+id/userCastv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:textSize="16sp"
                    android:inputType="number"
                    android:textStyle="bold"
                    android:hint="Puntos"
                    android:background="@null"
                    android:padding="0dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/fechaCreacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:text="fechaCreacion" />
            </LinearLayout>
        </LinearLayout>

        <!-- Iconos (sin cambios) (30%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="4dp">

            <ImageView
                android:id="@+id/editImage"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:src="@drawable/castv"
                android:scaleType="fitXY"
                android:layout_marginEnd="10dp"
                android:contentDescription="Editar usuario" />

            <ImageView
                android:id="@+id/deleteImage"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:src="@drawable/delete"
                android:scaleType="fitXY"
                android:contentDescription="Eliminar usuario" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
